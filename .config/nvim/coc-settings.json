{
  "suggest.noselect": true,
  "hover.floatConfig": {
    "maxWidth": 40,
    "maxHeight": 20
  },
  "suggest.floatConfig": {
      "maxWidth": 30
  },
  "diagnostic.errorSign": "E",
  "diagnostic.warningSign": "W",
  "diagnostic.infoSign": "I",
  "diagnostic.hintSign": "H",
  "inlayHint.enable": true,

  "languageserver": {
      "rust": {
          "command": "rust-analyzer",
          "filetypes": ["rust"],
          "rootPatterns": ["Cargo.toml"]
    }
  }
}
